// ============================================================
// Forzee — Secrets Configuration Example
// ============================================================
// 1. Copy this file to Secrets.xcconfig
//    $ cp Secrets.xcconfig.example Secrets.xcconfig
//
// 2. Fill in your API keys below
//
// 3. Secrets.xcconfig is .gitignored — never commit it
// ============================================================

// ── Apple Developer ─────────────────────────────────────────
// Your 10-character Apple Developer Team ID
// Found at: developer.apple.com/account → Membership
DEVELOPMENT_TEAM = YOUR_TEAM_ID_HERE

// ── Anthropic Claude API ──────────────────────────────────────
// NOT a client secret anymore — Claude calls go through the
// claude-chat Supabase Edge Function, which holds the real key
// server-side (`supabase secrets set ANTHROPIC_API_KEY=sk-ant-...`).
// A key shipped in this file would ship inside every installed copy
// of the app, extractable by anyone; see supabase/functions/claude-chat.

// ── Supabase ─────────────────────────────────────────────────
// Found in Supabase Dashboard → Project Settings → API
//
// NOTE: .xcconfig files treat "//" as a comment marker, so a plain
// "https://..." value gets truncated to just "https:" at build time.
// Break up the double slash with an empty macro expansion — $() —
// which disappears after substitution but stops the comment parser:
SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-supabase-anon-key-here

// ── RevenueCat ───────────────────────────────────────────────
// Found in RevenueCat Dashboard → Project → API Keys.
// Use the iOS PUBLIC key (starts with appl_) — it's designed to ship
// in apps. Never put the RevenueCat SECRET key here; that one goes in
// Supabase: `supabase secrets set REVENUECAT_SECRET_API_KEY=...`
REVENUECAT_API_KEY = appl_your-revenuecat-key-here

// ── ElevenLabs (Premium Voice — Kai) ─────────────────────────
// NOT set here — the kai-voice Edge Function holds it:
//   supabase secrets set ELEVENLABS_API_KEY=... ELEVENLABS_VOICE_ID=...

// ── Rule for this file ───────────────────────────────────────
// Everything here ends up inside the app, readable by anyone who
// installs it. Only values designed to be public belong here.
// Anything that can spend money or read other users' data is a
// Supabase secret used by an Edge Function (supabase/functions/).
